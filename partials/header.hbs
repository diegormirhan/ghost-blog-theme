<header class="hd">
    <div class="wrap hd-in">
        <a class="brand display" href="{{@site.url}}" data-brand><span class="brand-text">{{@site.title}}</span><span class="brand-dot" aria-hidden="true">.</span></a>

        <nav class="hd-nav" aria-label="{{t "Main"}}">
            {{navigation}}
            {{#if @custom.main_site_url}}
                <a href="{{@custom.main_site_url}}" rel="noopener">{{t "Portfolio"}} <span class="arr" aria-hidden="true">↗</span></a>
            {{/if}}
        </nav>

        <div class="hd-tools">
            <button class="icon-btn theme-btn" type="button" data-theme-toggle data-label-light="{{t "Switch to light theme"}}" data-label-dark="{{t "Switch to dark theme"}}" aria-label="{{t "Switch theme"}}">
                <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/></svg>
            </button>
            <button class="icon-btn" type="button" data-ghost-search aria-label="{{t "Search"}}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a class="btn btn-solid hd-sub" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                {{else}}
                    <a class="btn hd-sub" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                {{/unless}}
            {{/if}}
            <button class="btn hd-menu" type="button" data-menu-toggle data-label-open="{{t "Menu"}}" data-label-close="{{t "Close"}}" aria-expanded="false" aria-controls="hd-panel">{{t "Menu"}}</button>
        </div>
    </div>

    <div class="hd-panel" id="hd-panel" hidden>
        <nav class="wrap" aria-label="{{t "Mobile"}}">
            {{navigation}}
            {{#if @custom.main_site_url}}
                <a href="{{@custom.main_site_url}}" rel="noopener">{{t "Portfolio"}} <span class="arr" aria-hidden="true">↗</span></a>
            {{/if}}
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                {{/unless}}
            {{/if}}
        </nav>
    </div>
</header>
