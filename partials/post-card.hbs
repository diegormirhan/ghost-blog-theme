<article class="card {{post_class}}">
    <a class="card-img" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img loading="lazy" src="{{img_url feature_image size="s"}}"
                 srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 640w"
                 sizes="168px" alt="">
        {{else}}
            <span class="cover-type">{{#primary_tag}}{{name}}{{else}}{{@site.title}}{{/primary_tag}}</span>
        {{/if}}
    </a>
    <div class="card-body">
        <p class="meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>{{#primary_tag}} · {{name}}{{/primary_tag}}</p>
        <h2 class="display card-title"><a href="{{url}}">{{title}}</a></h2>
        <p class="card-ex">{{excerpt words="18"}}</p>
    </div>
</article>
