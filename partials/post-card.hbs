<article class="pc {{post_class}}">
    <a class="pc-cover" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img class="cover" loading="lazy"
                 src="{{img_url feature_image size="m"}}"
                 srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 640w, {{img_url feature_image size="l"}} 1000w"
                 sizes="(max-width: 760px) 92vw, (max-width: 1100px) 44vw, 300px"
                 alt="">
        {{else}}
            <span class="cover cover-none"></span>
        {{/if}}
    </a>
    <div class="meta">
        {{#if primary_tag}}<a class="chip" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <span class="mono muted"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D"}}</time> · {{reading_time minute="1 min" minutes="% min"}}</span>
    </div>
    <h3 class="display sm"><a href="{{url}}">{{title}}</a></h3>
</article>
