<section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
        <h1 class="display hero-title" id="hero-title">{{#if @custom.hero_title}}{{@custom.hero_title}}{{else}}{{@site.title}}{{/if}}</h1>
        {{#if @custom.hero_subtitle}}<p class="hero-sub">{{@custom.hero_subtitle}}</p>{{/if}}
        <div class="hero-cta">
            {{#if @custom.main_site_url}}<a class="btn btn-light" href="{{@custom.main_site_url}}" rel="noopener">{{t "See portfolio"}}</a>{{/if}}
            {{#if @custom.contact_email}}<a class="btn" href="mailto:{{@custom.contact_email}}">{{t "Talk to me"}}</a>{{/if}}
        </div>
        {{#if @site.members_enabled}}
            {{#unless @member}}
            <div class="hero-news" id="assinar">
                <p class="hero-news-title">{{t "Get new posts by email"}}</p>
                {{> subscribe}}
            </div>
            {{/unless}}
        {{/if}}
    </div>
    {{> projects}}
</section>
