<article class="feat {{post_class}}">
    <a class="feat-cover" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img class="cover" src="{{img_url feature_image size="l"}}"
                 srcset="{{img_url feature_image size="m"}} 640w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(max-width: 760px) 92vw, 55vw" alt="">
        {{else}}
            <span class="cover cover-none"></span>
        {{/if}}
    </a>
    <div class="pc">
        <div class="meta">
            {{#if primary_tag}}<a class="chip" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            <span class="mono muted"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time> · {{reading_time minute="1 min read" minutes="% min read"}}</span>
        </div>
        <h2 class="display md feat-title"><a href="{{url}}">{{title}}</a></h2>
        <p>{{excerpt words="28"}}</p>
    </div>
</article>
