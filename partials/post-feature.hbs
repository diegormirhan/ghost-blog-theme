<article class="feat {{post_class}}">
    <a class="feat-img" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img style="view-transition-name: cover-{{id}}" src="{{img_url feature_image size="l"}}"
                 srcset="{{img_url feature_image size="m"}} 640w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(max-width: 900px) 92vw, 640px" alt="">
        {{else}}
            <span class="cover-type cover-type-lg">{{#primary_tag}}{{name}}{{else}}{{@site.title}}{{/primary_tag}}</span>
        {{/if}}
    </a>
    <div class="feat-body">
        <p class="meta">{{#primary_tag}}<a href="{{url}}">{{name}}</a> · {{/primary_tag}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></p>
        <h2 class="display feat-title"><a href="{{url}}" style="view-transition-name: title-{{id}}">{{title}}</a></h2>
        <p class="feat-ex">{{excerpt words="30"}}</p>
        <a class="more" href="{{url}}">{{t "Read the post"}}</a>
    </div>
</article>
