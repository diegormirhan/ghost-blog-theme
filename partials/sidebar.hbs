<aside class="sb" aria-label="{{t "About and links"}}">
    <div>
        <div class="who">
            {{#if @site.icon}}
                <img class="av" src="{{img_url @site.icon size="xs"}}" alt="">
            {{else}}
                <span class="av" aria-hidden="true"></span>
            {{/if}}
            <div><b>{{@site.title}}</b></div>
        </div>
        {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
    </div>

    {{#get "tags" limit="8" order="count.posts desc" include="count.posts"}}
        {{#if tags}}
        <div>
            <h2 class="sb-title">{{t "Tags"}}</h2>
            <div class="tags">
                {{#foreach tags}}<a class="chip" href="{{url}}">{{name}} · {{count.posts}}</a>{{/foreach}}
            </div>
        </div>
        {{/if}}
    {{/get}}

    {{#get "posts" filter="featured:true" limit="3"}}
        {{#if posts}}
        <div>
            <h2 class="sb-title">{{t "Featured"}}</h2>
            <ol>
                {{#foreach posts}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}
            </ol>
        </div>
        {{/if}}
    {{/get}}

    <div>
        <h2 class="sb-title">{{t "Links"}}</h2>
        <div class="soc">
            {{#if @custom.main_site_url}}<a href="{{@custom.main_site_url}}" rel="noopener">{{t "Portfolio"}} <span aria-hidden="true">↗</span></a>{{/if}}
            {{#if @custom.github_url}}<a href="{{@custom.github_url}}" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>{{/if}}
            {{#if @custom.linkedin_url}}<a href="{{@custom.linkedin_url}}" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>{{/if}}
            {{#if @custom.medium_url}}<a href="{{@custom.medium_url}}" rel="noopener">Medium <span aria-hidden="true">↗</span></a>{{/if}}
            <a href="{{@site.url}}/rss/">RSS <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</aside>
