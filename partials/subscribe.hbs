{{!-- Ghost Members signup form. Ghost adds .loading / .success / .error to the form. --}}
<form class="subscribe-form" data-members-form="subscribe" data-members-autoredirect="false">
    <div class="subscribe-row">
        <label class="subscribe-field">
            <span class="subscribe-label mono">{{t "Your email"}}</span>
            <input data-members-email type="email" name="email" required placeholder="{{t "you@email.com"}}" autocomplete="email">
        </label>
        <button type="submit" class="sbtn">
            <span class="idle">{{t "Subscribe"}}</span>
            <span class="busy">{{t "Sending…"}}</span>
        </button>
    </div>
    <p class="subscribe-msg msg-ok" role="status">{{t "Check your inbox for the confirmation link."}}</p>
    <p class="subscribe-msg msg-err" role="alert" data-members-error>{{t "Something went wrong. Please try again."}}</p>
</form>
