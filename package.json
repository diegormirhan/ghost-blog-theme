{
  "name": "diego-mirhan",
  "description": "Personal blog theme for Diego Mirhan: calm editorial layout, a home hero with an animated deck of real project screenshots, dark/light, pt-BR UI, WCAG 2.2 AA.",
  "version": "2.3.2",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Diego Mirhan",
    "email": "mirhan.diego@gmail.com",
    "url": "https://www.diegomirhan.com"
  },
  "keywords": [
    "ghost-theme",
    "blog",
    "personal"
  ],
  "scripts": {
    "zip": "git archive --format=zip -o diego-mirhan.zip HEAD",
    "test": "npm run zip && gscan --zip diego-mirhan.zip"
  },
  "devDependencies": {
    "gscan": "^6.6.1"
  },
  "screenshots": {},
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xs": {
        "width": 150
      },
      "s": {
        "width": 320
      },
      "m": {
        "width": 640
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": true,
    "custom": {
      "hero_title": {
        "type": "text",
        "default": "IA local, do modelo à interface",
        "group": "homepage",
        "description": "Headline at the top of the home page"
      },
      "hero_subtitle": {
        "type": "text",
        "default": "Sou Diego Mirhan, estudante de Ciência da Computação. Aqui escrevo sobre o que construo e testo com LLMs locais, RAG, visão computacional e engenharia de dados.",
        "group": "homepage",
        "description": "Text below the headline"
      },
      "contact_email": {
        "type": "text",
        "default": "contato@diegomirhan.com",
        "group": "homepage",
        "description": "Used by the \"Talk to me\" buttons and the footer"
      },
      "main_site_url": {
        "type": "text",
        "default": "https://www.diegomirhan.com",
        "group": "homepage"
      },
      "github_url": {
        "type": "text",
        "default": "https://github.com/diegormirhan",
        "group": "homepage"
      },
      "linkedin_url": {
        "type": "text",
        "default": "https://www.linkedin.com/in/diegomirhan",
        "group": "homepage"
      },
      "medium_url": {
        "type": "text",
        "default": "https://medium.com/@diegomirhan",
        "group": "homepage"
      }
    }
  }
}
