{{!< default}}

{{#is "home"}}
    {{> hero}}
    {{#if @custom.show_carousel}}
        {{> carousel}}
    {{/if}}

    {{#foreach posts limit="1"}}
        {{> post-feature}}
    {{/foreach}}

    <div class="lay">
        {{> sidebar}}
        <div class="lay-main">
            <h2 class="section-title mono">{{t "Latest posts"}}</h2>
            <div class="grid3">
                {{#foreach posts from="2"}}
                    {{> post-card}}
                {{/foreach}}
            </div>
            {{pagination}}
        </div>
    </div>
{{else}}
    <div class="lay lay-top">
        {{> sidebar}}
        <div class="lay-main">
            <h1 class="section-title mono">{{t "Latest posts"}}</h1>
            <div class="grid3">
                {{#foreach posts}}
                    {{> post-card}}
                {{/foreach}}
            </div>
            {{pagination}}
        </div>
    </div>
{{/is}}
