{{!< default}}

{{#is "home"}}
    {{> hero}}

    {{!-- A post marked "Feature this post" in Ghost gets its own section on top. The latest posts follow as a uniform
          grid, so nothing competes with it. Without a featured post, the first card of the grid is shown big
          instead (CSS, .home-latest). The grid stays outside the get block, which would hide the page's posts. --}}
    {{#get "posts" filter="featured:true" limit="1" as |featured|}}
        {{#if featured}}
            <section class="wrap home-posts home-featured" aria-labelledby="featured-title">
                <h2 class="display section-title" id="featured-title">{{t "Featured"}}</h2>
                {{#foreach featured}}
                    {{> post-feature}}
                {{/foreach}}
            </section>
        {{/if}}
    {{/get}}
    <section class="wrap home-posts home-latest" aria-labelledby="latest-title">
        <h2 class="display section-title" id="latest-title">{{t "Latest posts"}}</h2>
        <div class="grid">
            {{#foreach posts}}
                {{#unless featured}}{{> post-card}}{{/unless}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
{{else}}
    <section class="wrap page-posts">
        <header class="page-head">
            <h1 class="display page-title">{{t "Latest posts"}}</h1>
        </header>
        <div class="grid">
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
{{/is}}
