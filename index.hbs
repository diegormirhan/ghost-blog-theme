{{!< default}}

{{#is "home"}}
    {{> hero}}

    {{!-- A post marked "Feature this post" in Ghost gets the big slot in its own section; without one, the latest
          post takes the big slot. Either way the rest is a uniform grid, so nothing competes with the big one.
          ../posts is the home page's own list (the get block replaces the context); pagination stays outside. --}}
    {{#get "posts" filter="featured:true" limit="1" as |featured|}}
        {{#if featured}}
            <section class="wrap home-posts home-featured" aria-labelledby="featured-title">
                <h2 class="display section-title" id="featured-title">{{t "Featured"}}</h2>
                {{#foreach featured}}
                    {{> post-feature}}
                {{/foreach}}
            </section>
            <section class="wrap home-posts" aria-labelledby="latest-title">
                <h2 class="display section-title" id="latest-title">{{t "Latest posts"}}</h2>
                <div class="grid">
                    {{#foreach ../posts}}
                        {{#unless featured}}{{> post-card}}{{/unless}}
                    {{/foreach}}
                </div>
        {{else}}
            <section class="wrap home-posts" aria-labelledby="latest-title">
                <h2 class="display section-title" id="latest-title">{{t "Latest posts"}}</h2>
                {{#foreach ../posts limit="1"}}
                    {{> post-feature}}
                {{/foreach}}
                <div class="grid">
                    {{#foreach ../posts from="2"}}
                        {{> post-card}}
                    {{/foreach}}
                </div>
        {{/if}}
    {{/get}}
        {{pagination}}
    </section>
{{else}}
    <section class="wrap page-posts">
        <header class="page-head">
            <h1 class="display page-title">{{t "Latest posts"}}</h1>
        </header>
        <div class="grid">
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
{{/is}}
