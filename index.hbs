{{!< default}}

{{#is "home"}}
    {{> hero}}

    <section class="wrap home-posts" aria-labelledby="latest-title">
        <h2 class="display section-title" id="latest-title">{{t "Latest posts"}}</h2>
        {{#foreach posts limit="1"}}
            {{> post-feature}}
        {{/foreach}}
        <div class="grid">
            {{#foreach posts from="2"}}
                {{> post-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
{{else}}
    <section class="wrap page-posts">
        <header class="page-head">
            <h1 class="display page-title">{{t "Latest posts"}}</h1>
        </header>
        <div class="grid">
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
{{/is}}
