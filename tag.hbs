{{!< default}}

<section class="wrap page-posts">
    {{#tag}}
    <header class="page-head">
        <p class="meta">{{t "Tag"}} · {{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}</p>
        <h1 class="display page-title">{{name}}</h1>
        {{#if description}}<p class="page-desc">{{description}}</p>{{/if}}
    </header>
    {{/tag}}
    <div class="grid">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
