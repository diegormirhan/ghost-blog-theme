{{!< default}}

<section class="wrap page-posts">
    {{#author}}
    <header class="page-head author-head">
        {{#if profile_image}}<img class="av av-lg" src="{{img_url profile_image size="s"}}" alt="">{{/if}}
        <div>
            <p class="meta">{{t "Author"}} · {{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}</p>
            <h1 class="display page-title">{{name}}</h1>
            {{#if bio}}<p class="page-desc">{{bio}}</p>{{/if}}
            <p class="head-links">
                {{#if website}}<a href="{{website}}" rel="noopener">{{t "Website"}} <span aria-hidden="true">↗</span></a>{{/if}}
                {{#if twitter}}<a href="{{social_url type="twitter"}}" rel="noopener">X <span aria-hidden="true">↗</span></a>{{/if}}
            </p>
        </div>
    </header>
    {{/author}}
    <div class="grid">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </div>
    {{pagination}}
</section>
