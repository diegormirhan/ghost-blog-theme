{{!< default}}

{{#post}}
<article class="post {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="post-head">
        <h1 class="display md post-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="lead muted">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{/if}}

    {{#if @page.show_title_and_feature_image}}
    {{#if feature_image}}
    <figure class="post-cover">
        <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
    </figure>
    {{/if}}
    {{/if}}

    <div class="gh-content prose">
        {{content}}
    </div>
</article>
{{/post}}
